{
  "appId": "com.rajaxdx.huroof",
  "appName": "صراع الحروف",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#080B12"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#080B12",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080B12",
      "overlaysWebView": true
    }
  }
}
